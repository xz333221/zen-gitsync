{
  "name": "zen-gitsync",
  "version": "2.18.2",
  "description": "Auto commit, scheduled sync, and visual GUI for Git. Run `g` in any repo for one-key commit & push, AI commit messages, scheduled background sync, and a drag-and-drop workflow builder.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "g:ui": "node ./src/gitCommit.js ui",
    "g:ai": "node ./src/gitCommit.js ai",
    "update:g": "npm install -g zen-gitsync --registry https://registry.npmjs.org/ --prefer-online",
    "npm:login": "npm login --registry https://registry.npmjs.org/",
    "npm:publish": "npm publish --registry https://registry.npmjs.org/",
    "npm:whoami": "npm whoami --registry https://registry.npmjs.org/",
    "pull": "git pull",
    "dev:server": "cross-env ZEN_PERF=1 PORT=5545 nodemon server.js --no-open",
    "dev:vue": "node scripts/ensure-client-deps.cjs && cd ./src/ui/client && cross-env ZEN_PERF=1 npm run dev",
    "install:vue": "cd ./src/ui/client && npm install --legacy-peer-deps",
    "dev": "concurrently -n backend,vite -c blue,green --prefix \"[{time}][{name}]\" --timestamp-format \"HH:mm:ss.SSS\" \"npm:dev:server\" \"npm:dev:vue\"",
    "dev:ping": "node scripts/dev-ping.cjs",
    "start:server:no-open": "node server.js --no-open",
    "start:vue": "cd ./src/ui/client && npm run dev",
    "release": "node ./scripts/release.js",
    "test": "node scripts/run-tests.cjs",
    "test:watch": "node scripts/run-tests.cjs --watch",
    "verify:i18n": "node scripts/verify-i18n-keys.mjs",
    "verify:i18n:orphans": "node scripts/verify-i18n-keys.mjs --orphans",
    "verify:config-concurrency": "node scripts/verify-config-concurrency.mjs",
    "verify:data-dir-migration": "node scripts/verify-data-dir-migration.mjs",
    "verify:config-split": "node scripts/verify-config-split.mjs",
    "verify:package-files": "node --test test/package-files.test.mjs",
    "verify:memory-context": "node scripts/verify-memory-context.cjs",
    "verify:memory-panel": "node scripts/verify-memory-panel.cjs",
    "verify:release:self-update": "node scripts/verify-release-self-update.mjs",
    "verify:release:self-update:reverse": "node scripts/verify-release-self-update.mjs --reverse",
    "verify:wb-agent-dispatch": "node scripts/verify-workbench-agent-dispatch.mjs",
    "verify:wb-oc-modes": "node scripts/verify-wb-oc-agent-chat.cjs",
    "verify:wb-oc-modes:reverse": "node scripts/verify-wb-oc-agent-chat-reverse.cjs",
    "verify:wb-default-prompt": "node scripts/verify-workbench-default-prompt.cjs",
    "verify:wb-dialogs": "node scripts/verify-workbench-dialogs.cjs",
    "verify:wb-dispatch": "node scripts/verify-workbench-dispatch-attach.cjs",
    "verify:wb-env-context": "node scripts/verify-workbench-env-context.mjs",
    "verify:wb-live-jobs": "node scripts/verify-wb-live-jobs.mjs",
    "verify:wb-manual-done": "node scripts/verify-wb-manual-done.mjs",
    "verify:wb-bubble-prompt": "node scripts/verify-wb-bubble-prompt.cjs",
    "verify:wb-copy-execution": "node scripts/verify-wb-copy-execution.cjs",
    "verify:wb-overview": "node scripts/verify-workbench-overview.cjs",
    "verify:wb-progress-report": "node scripts/verify-wb-progress-report.cjs",
    "verify:wb-card-live": "node scripts/verify-wb-card-live.cjs",
    "verify:wb-card-row1": "node scripts/verify-wb-card-row1.cjs",
    "verify:wb-card-reply": "node scripts/verify-wb-card-reply.cjs",
    "verify:wb-task-duration": "node scripts/verify-wb-task-duration.cjs",
    "verify:wb-card-executor-icon": "node scripts/verify-wb-card-executor-icon.cjs",
    "verify:wb-card-opened": "node scripts/verify-wb-card-opened.cjs",
    "verify:wb-card-opened:reverse": "node scripts/verify-wb-card-opened.cjs --reverse",
    "verify:wb-card-stop": "node scripts/verify-wb-card-stop.cjs",
    "verify:wb-card-stop:reverse": "node scripts/verify-wb-card-stop.cjs --reverse",
    "verify:wb-card-fade-band": "node scripts/verify-wb-card-fade-band.cjs",
    "verify:wb-card-fade-band:reverse": "node scripts/verify-wb-card-fade-band.cjs --reverse",
    "verify:wb-card-done": "node scripts/verify-wb-card-done.cjs",
    "verify:wb-card-done:reverse": "node scripts/verify-wb-card-done.cjs --reverse",
    "verify:wb-rerun-label": "node scripts/verify-wb-rerun-label.cjs",
    "verify:wb-rerun-label:reverse": "node scripts/verify-wb-rerun-label.cjs --reverse",
    "verify:wb-auto-done": "node scripts/verify-wb-auto-done.cjs",
    "verify:wb-auto-done:reverse": "node scripts/verify-wb-auto-done.cjs --reverse",
    "verify:wb-card-cover": "node scripts/verify-wb-card-cover.cjs",
    "verify:wb-card-cover:reverse": "node scripts/verify-wb-card-cover.cjs --reverse",
    "verify:wb-list-view": "node scripts/verify-wb-list-view.cjs",
    "verify:wb-executor-models": "node scripts/verify-wb-executor-models.cjs",
    "verify:wb-task-sound": "node scripts/verify-wb-task-sound.cjs",
    "verify:wb-proj-branch": "node scripts/verify-workbench-proj-branch.cjs",
    "verify:wb-proj-filter": "node scripts/verify-wb-proj-filter.cjs",
    "verify:wb-proj-search": "node scripts/verify-wb-proj-search.cjs",
    "verify:wb-proj-search:reverse": "node scripts/verify-wb-proj-search.cjs --reverse",
    "verify:wb-proj-remove": "node scripts/verify-wb-project-remove.cjs",
    "verify:wb-panel-resize": "node scripts/verify-wb-panel-resize.cjs",
    "verify:wb-toolcalls": "node scripts/verify-workbench-toolcalls.mjs",
    "verify:wb-responsive": "node scripts/verify-wb-responsive.cjs",
    "verify:wb-editor-persist": "node scripts/verify-workbench-editor-persist.cjs",
    "verify:wb-open-scroll-bottom": "node scripts/verify-workbench-open-scroll-bottom.cjs",
    "verify:chat-rail": "node scripts/verify-chat-message-rail.cjs",
    "verify:agent-session-copy": "node scripts/verify-agent-session-copy.cjs",
    "verify:agent-retry": "node scripts/verify-agent-llm-retry.cjs",
    "verify:editor-preview-scroll": "node scripts/verify-editor-preview-scroll.cjs",
    "verify:editor-sidebar-width": "node scripts/verify-editor-sidebar-width.cjs",
    "verify:editor-disk-sync": "node scripts/verify-editor-disk-sync.cjs",
    "verify:wb-copy-folder-name": "node scripts/verify-copy-folder-name.cjs",
    "verify:marketplace-panel": "node scripts/verify-marketplace-panel.cjs",
    "verify:wb-open-with-permission": "node scripts/verify-open-with-permission-menus.cjs",
    "verify:open-with-permission": "node --test test/open-with-permission.test.mjs",
    "verify:repo-list": "node scripts/verify-repo-list.cjs",
    "verify:startup-ai-panel": "node scripts/verify-startup-ai-panel.cjs",
    "verify:startup-ai-panel:reverse": "node scripts/verify-startup-ai-panel.cjs --reverse",
    "verify:startup-ai-panel:empty": "node scripts/verify-startup-ai-panel.cjs --empty",
    "verify:instance-close-hover": "node scripts/verify-instance-close-hover.cjs",
    "verify:instance-close-hover:reverse": "node scripts/verify-instance-close-hover.cjs --reverse",
    "e2e": "cd src/ui/client && npx playwright test",
    "e2e:headed": "cd src/ui/client && npx playwright test --headed",
    "e2e:install": "cd src/ui/client && npx playwright install chromium",
    "audit": "npm audit --omit=dev",
    "audit:ci": "npm audit --audit-level=high --omit=dev",
    "g": "node ./src/gitCommit.js",
    "g:m": "node ./src/gitCommit.js -m='test'",
    "g:m2": "node ./src/gitCommit.js -m testmsg",
    "g:y:interval": "node ./src/gitCommit.js -y --interval",
    "g:y:interval10": "node ./src/gitCommit.js -y --interval=10",
    "g:cwd": "node ./src/gitCommit.js --path=./",
    "g:cwd2": "node ./src/gitCommit.js --path=../",
    "g:no-diff": "node ./src/gitCommit.js --no-diff",
    "g:log": "node ./src/gitCommit.js log",
    "g:log5": "node ./src/gitCommit.js log --n=5",
    "g:h": "node ./src/gitCommit.js -h",
    "g:get-config": "node ./src/gitCommit.js get-config",
    "g:addScript": "node ./src/gitCommit.js addScript",
    "g:addResetScript": "node ./src/gitCommit.js addResetScript",
    "g:set-default-message": "node ./src/gitCommit.js --set-default-message=\"提交\"",
    "g:y": "g -y",
    "danger:reset": "git reset --hard origin/main",
    "g:test-cmd": "node ./src/gitCommit.js --cmd=\"echo zen-gitsync test\" --cmd-interval=5",
    "g:test-cmd-at": "node ./src/gitCommit.js --cmd=\"echo at-time-test\" --at=21:09",
    "start:server": "node server.js",
    "nrm:ls": "nrm ls",
    "change:nrm:npm": "nrm use npm",
    "change:nrm:lenovo-nexus": "nrm use lenovo-nexus",
    "npm:ls:g": "npm ls -g",
    "npm:2fa:get": "npm profile get",
    "npm:2fa:disable": "npm profile disable-2fa",
    "verify:wb-select-popup": "node scripts/verify-native-select-popup.cjs",
    "verify:wb-inline-images": "node scripts/verify-wb-inline-images.mjs",
    "verify:wb-colors": "node scripts/verify-wb-colors.cjs",
    "verify:wb-colors:reverse": "node scripts/verify-wb-colors.cjs --reverse",
    "verify:ui-consistency": "node scripts/verify-ui-consistency.cjs",
    "verify:commit-area-no-bounce": "node scripts/verify-commit-area-no-bounce.cjs",
    "verify:commit-area-no-bounce:reverse": "node scripts/verify-commit-area-no-bounce.cjs --reverse",
    "verify:git-operations-drawer": "node scripts/verify-git-operations-drawer.cjs",
    "verify:git-operations-drawer:reverse": "node scripts/verify-git-operations-drawer.cjs --reverse",
    "verify:commit-ai-suffix": "node scripts/verify-commit-ai-suffix.cjs",
    "verify:commit-ai-suffix:reverse": "node scripts/verify-commit-ai-suffix.cjs --reverse",
    "verify:header-monitor": "node scripts/verify-header-monitor.cjs",
    "verify:header-git-buttons": "node scripts/verify-header-git-buttons.cjs",
    "verify:header-git-buttons:reverse": "node scripts/verify-header-git-buttons.cjs --reverse"
  },
  "files": [
    "src/ui/public/**",
    "src/ui/server/**",
    "src/utils/**",
    "src/memory/**",
    "src/gitCommit.js",
    "src/aiCommit.js",
    "src/config.js",
    "src/paths.js",
    "src/fsAtomic.js",
    "src/configSplit.js",
    "src/dataDirMigration.js",
    "src/cli/**",
    "scripts/run-tests.cjs",
    "scripts/release.js",
    "scripts/dev-ping.cjs",
    "package.json",
    "index.js"
  ],
  "bin": {
    "g": "./src/gitCommit.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xz333221/zen-gitsync.git"
